{
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Automatically generate standard W3C traceparent (ADR-010) and X-Trace-Id",
          "function generateHex(len) {",
          "    let result = '';",
          "    const chars = '0123456789abcdef';",
          "    for (let i = 0; i < len; i++) {",
          "        result += chars.charAt(Math.floor(Math.random() * chars.length));",
          "    }",
          "    return result;",
          "}",
          "const traceId = generateHex(32);",
          "const spanId = generateHex(16);",
          "const traceparent = `00-${traceId}-${spanId}-01`;",
          "pm.request.headers.upsert({ key: 'traceparent', value: traceparent });",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: traceId });",
          "pm.environment.set('currentTraceId', traceId);"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "info": {
    "_exporter_id": "39879181",
    "_postman_id": "a1c3e5f7-4b6d-4e8f-9a1b-6c8d0e2f4a5b",
    "description": "E2E Postman Suite for the dedicated platform gateway (ADR-022). The gateway has no domain of its own - this suite proves the reverse-proxy contract instead: an unconfigured domain and a denied internal-only path are both a 404 ERR-GTW-00404 (indistinguishable from the outside, ADR-022), a real request/response round trip through a configured upstream (method, body, headers and status all forwarded unchanged), and that the upstream's own errors pass through untouched rather than being reinterpreted by the gateway. Security-on scenarios (bearer auth, rate limiting) are covered live by thinklab-platform/scripts/e2e/secured-smoke.ps1 instead, since they need THINKLAB_SECURITY_ENABLED and a bootstrap secret set before the stack starts - outside what a fixed Postman environment can express.",
    "name": "Platform Gateway Service - Routing & Security Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
